  "code": "import numpy as np\nimport time\n\n\ndef project_to_feasible(g, n):\n    target = n / 2.0\n    lo = g.min() - 2.0\n    hi = g.max() + 2.0\n    for _ in range(80):\n        mid = (lo + hi) / 2.0\n        s = np.sum(np.clip(g - mid, 0.0, 1.0))\n        if s > target:\n            lo = mid\n        else:\n            hi = mid\n    return np.clip(g - (lo + hi) / 2.0, 0.0, 1.0)\n\n\ndef interp_periodic(h, target_n):\n    n = len(h)\n    if n == target_n:\n        return h.copy()\n    x_old = np.arange(n) * (2.0 / n)\n    x_new = np.arange(target_n) * (2.0 / target_n)\n    return np.interp(x_new, x_old, h, period=2.0)\n\n\ndef compute_corr(h):\n    return np.correlate(h, 1.0 - h, mode='full')\n\n\ndef compute_c5(h):\n    n = len(h)\n    return compute_corr(h).max() * (2.0 / n)\n\n\ndef smooth_obj_grad(h, tau):\n    n = len(h)\n    dx = 2.0 / n\n    corr = compute_corr(h)\n    max_c = corr.max()\n    shifted = np.clip(tau * (corr - max_c), -400, 400)\n    exp_c = np.exp(shifted)\n    s = exp_c.sum()\n    p = exp_c / s\n    grad = np.zeros(n)\n    for k in range(2 * n - 1):\n        pk = p[k]\n        if pk < 1e-16:\n            continue\n        sh = k - n + 1\n        j0 = max(0, sh)\n        j1 = min(n, sh + n)\n        if j0 < j1:\n            grad[j0:j1] += pk * (1.0 - h[np.arange(j0, j1) - sh])\n        j0b = max(0, -sh)\n        j1b = min(n, n - sh)\n        if j0b < j1b:\n            grad[j0b:j1b] -= pk * h[np.arange(j0b, j1b) + sh]\n    grad *= dx\n    obj = dx * (max_c + np.log(s) / tau)\n    return obj, grad\n\n\ndef optimize_smooth(h, n, tau, max_iters, time_limit, initial_lr=None):\n    dx = 2.0 / n\n    h = project_to_feasible(h, n).copy()\n    best_obj, _ = smooth_obj_grad(h, tau)\n    best_h = h.copy()\n    start = time.time()\n    if initial_lr is None:\n        lr = 0.5\n    else:\n        lr = initial_lr\n    v = np.zeros(n)\n    beta = 0.9\n    stall = 0\n    best_stall = 0\n\n    for it in range(max_iters):\n        if time.time() - start > time_limit:\n            break\n        obj, grad = smooth_obj_grad(h, tau)\n        if obj < best_obj - 1e-14:\n            best_obj = obj\n            best_h = h.copy()\n            stall = 0\n        else:\n            stall += 1\n\n        v = beta * v - lr * grad\n        h_new = project_to_feasible(h + v, n)\n\n        if stall > 80:\n            lr *= 0.5\n            v *= 0.5\n            stall = 0\n            if lr < 1e-8:\n                break\n\n        h = h_new\n\n    return best_h, best_obj\n\n\ndef optimize_subgrad(h, n, max_iters, time_limit, initial_lr=None):\n    dx = 2.0 / n\n    h = project_to_feasible(h, n).copy()\n    best_c5 = compute_c5(h)\n    best_h = h.copy()\n    start = time.time()\n    if initial_lr is None:\n        lr = 0.01\n    else:\n        lr = initial_lr\n    v = np.zeros(n)\n    beta = 0.85\n    stall = 0\n\n    for it in range(max_iters):\n        if time.time() - start > time_limit:\n            break\n        corr = compute_corr(h)\n        c5_cur = corr.max() * dx\n        if c5_cur < best_c5 - 1e-14:\n            best_c5 = c5_cur\n            best_h = h.copy()\n            stall = 0\n        else:\n            stall += 1\n\n        k_star = np.argmax(corr)\n        sh = k_star - n + 1\n        grad = np.zeros(n)\n        j0 = max(0, sh)\n        j1 = min(n, sh + n)\n        if j0 < j1:\n            grad[j0:j1] += (1.0 - h[np.arange(j0, j1) - sh])\n        j0b = max(0, -sh)\n        j1b = min(n, n - sh)\n        if j0b < j1b:\n            grad[j0b:j1b] -= h[np.arange(j0b, j1b) + sh]\n        grad *= dx\n\n        v = beta * v - lr * grad\n        h_new = project_to_feasible(h + v, n)\n\n        if stall > 200:\n            lr *= 0.5\n            v *= 0.5\n            stall = 0\n            if lr < 1e-12:\n                break\n\n        h = h_new\n\n    return best_h, best_c5\n\n\ndef run(seed=42, budget_s=1300, **kwargs):\n    start_time = time.time()\n    np.random.seed(seed)\n\n    h_init = initial_h_values.copy()\n    n_init = len(h_init)\n    best_c5 = compute_c5(h_init)\n    best_h = h_init.copy()\n\n    def remaining():\n        return max(0.0, budget_s - (time.time() - start_time))\n\n    # Phase 1: moderate resolution\n    n1 = max(225, n_init * 5)\n    if remaining() > 60:\n        h1 = interp_periodic(best_h, n1)\n        h1 = project_to_feasible(h1, n1)\n        tl = remaining() * 0.25\n        h1, _ = optimize_smooth(h1, n1, tau=20.0, max_iters=8000, time_limit=tl, initial_lr=0.3)\n        c5_1 = compute_c5(h1)\n        if c5_1 < best_c5:\n            best_c5 = c5_1\n            best_h = h1.copy()\n\n    # Phase 2: higher resolution\n    n2 = max(450, n_init * 10)\n    if remaining() > 60:\n        h2 = interp_periodic(best_h, n2)\n        h2 = project_to_feasible(h2, n2)\n        tl = remaining() * 0.25\n        h2, _ = optimize_smooth(h2, n2, tau=15.0, max_iters=6000, time_limit=tl * 0.5, initial_lr=0.2)\n        if remaining() > 20:\n            h2, _ = optimize_smooth(h2, n2, tau=30.0, max_iters=4000, time_limit=tl * 0.5, initial_lr=0.1)\n        c5_2 = compute_c5(h2)\n        if c5_2 < best_c5:\n            best_c5 = c5_2\n            best_h = h2.copy()\n\n    # Phase 3: even higher resolution\n    n3 = max(900, n_init * 20)\n    if remaining() > 60:\n        h3 = interp_periodic(best_h, n3)\n        h3 = project_to_feasible(h3, n3)\n        tl = remaining() * 0.3\n        h3, _ = optimize_smooth(h3, n3, tau=15.0, max_iters=5000, time_limit=tl * 0.4, initial_lr=0.15)\n        if remaining() > 20:\n            h3, _ = optimize_smooth(h3, n3, tau=30.0, max_iters=4000, time_limit=tl * 0.3, initial_lr=0.1)\n        c5_3 = compute_c5(h3)\n        if c5_3 < best_c5:\n            best_c5 = c5_3\n            best_h = h3.copy()\n\n    # Phase 4: subgradient refinement\n    if remaining() > 20:\n        n_f = len(best_h)\n        h_f = best_h.copy()\n        h_f, c5_f = optimize_subgrad(h_f, n_f, max_iters=50000, time_limit=remaining() * 0.5, initial_lr=0.005)\n        if c5_f < best_c5:\n            best_c5 = c5_f\n            best_h = h_f.copy()\n\n    # Phase 5: try a second resolution with different tau\n    if remaining() > 30:\n        n_alt = n2 if n2 < n3 else n3\n        h_alt = interp_periodic(best_h, n_alt)\n        h_alt = project_to_feasible(h_alt, n_alt)\n        h_alt, _ = optimize_smooth(h_alt, n_alt, tau=50.0, max_iters=3000,\n                                   time_limit=remaining() * 0.3, initial_lr=0.05)\n        c5_alt = compute_c5(h_alt)\n        if c5_alt < best_c5:\n            best_c5 = c5_alt\n            best_h = h_alt.copy()\n\n    # Phase 6: final subgrad polish\n    if remaining() > 10:\n        n_final = len(best_h)\n        h_final = best_h.copy()\n        h_final, c5_final = optimize_subgrad(h_final, n_final, max_iters=50000,\n                                             time_limit=remaining() * 0.4, initial_lr=0.002)\n        if c5_final < best_c5:\n            best_c5 = c5_final\n            best_h = h_final.copy()\n\n    # Ensure feasibility\n    best_h = project_to_feasible(best_h, len(best_h))\n    final_c5 = compute_c5(best_h)\n    if final_c5 < best_c5:\n        best_c5 = final_c5\n\n    return best_h, best_c5, len(best_h)",
