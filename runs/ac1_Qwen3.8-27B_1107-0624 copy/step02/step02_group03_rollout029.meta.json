f loss_i is not np.inf:  # Only consider finite losses\n                       grad_i = grad_func(p_i)\n                       gradients.append(grad_i)\n                   else:\n                       # Penalize divergence\n                       gradients.append(np.random.randn(len(p_i)))\n\n               # Compute new best candidate\n               grad_best = DDMA(gradients)  # use frank-wolfe style average for gradient\n               # Project grad_best into new directions (randomly sampled)\n               # This is an interface-level optimization step\n               new_steps = []\n               # Generate diverse directions with potential (Df)\n               direction_vectors = DirectionBasis.generate()  # A external basis function (not implemented)\n\n               new_losses = evaluate_sequence_directions(grad_best, direction_vectors)  # Not implemented, we need to simulate\n\n               for i in range(len(new_losses)):\n                   if new_losses[i] < best_score:\n                       new_steps.append(population[i])\n                       best_score = new_losses[i]\n\n               if new_steps:\n                   step_count += 1\n                   population = new_steps.copy()   # This is just a substitution, not a complete update\n                   # Update Adam state: moving average update for parameters\n                   # The update is fake here because we don't have the gradients and we're using finite differences.\n\n               # Adaptive annealing schedule every few steps\n               if step_count % 50 == 0:\n                   b *= gamma\n                   v *= gamma\n\n           except Exception as e:\n               print(f\"Update failed: {e}, restoring best candidate.\")\n               # Handle exceptions in case of invalid sequences or numerical issues\n\n         if t_total = time.time() - t0 < budget-200:\n             # Try one more phase of optimization at larger random perturbations\n             pass