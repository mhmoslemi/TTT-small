t\": 100}\n    ]\n\n    best_seq = None\n    best_score = float('inf')\n\n    # Create a fallback: use a uniform sequence of length 512 (verified to be)\n    if best_seq is None:\n        fallback = np.ones(512)/512\n        best_seq = fallback.tolist()\n        best_score = float(evaluate_sequence(best_seq))\n\n    # If a base is available, initialize it\n    if candidates[0]['seq'] is not None:\n        base_seq = candidates[0]['seq'].tolist()\n        base_len = len(base_seq)\n        if base_len not in [512, 768, 1024]:\n            # Normalize to simplex\n            while any(x not in candidate_lengths for x in the sequence...) hmm, our plan to keep the sequence at one of the candidate lengths.\n\n    We'll implement a correction: only lengths 512, 768, and 1024 are allowed.\n\n    Step 1: Initialize candidate lists\n        cand_dict = {\n            \"512\": np.ones(512)/512,\n            \"768\": np.ones(768)/768,\n            \"1024\": np.ones(1024)/1024,\n        }\n        if parent is not None:\n            parent_len = len(parent)\n            if parent_len == 768:\n                cand_dict[\"768\"] = parent\n            elif parent_len <= 1024:\n                # Not exactly in cand_dict, but we'll allow it and then normalize later if needed.\n                pass\n\n    Step 2: Run maximize_peak for the desired length.\n\n    But note, the previous code has a multi-phase optimization.\n\n    We'll use the same strategy as the previous code but only for the chosen lengths.\n\n    However, to keep the answer self-contained and following the instructions, we present the complete plan without relying on internal helper functions.\n\n    After mapping out, we decide to output the following as the algorithm:",
