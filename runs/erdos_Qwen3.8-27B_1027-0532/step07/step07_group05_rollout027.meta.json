  "strategy": "\u010a1.\u0120Approach\u0120and\u0120rationale\u010a\u0120\u0120\u0120We\u0120introduce\u0120a\u0120novel\u0120dual-resolution\u0120optimization\u0120strategy\u0120combining\u0120spectrum\u0120analysis\u0120with\u0120adaptive\u0120local\u0120search\u0120to\u0120escape\u0120local\u0120minima.\u0120Unlike\u0120the\u0120parental\u0120approach's\u0120sequential\u0120optimization,\u0120we:\u0120(1)\u0120analyze\u0120the\u0120frequency\u0120domain\u0120to\u0120isolate\u0120problematic\u0120frequency\u0120components,\u0120(2)\u0120selectively\u0120invalidate\u0120temporarily\u0120trapped\u0120solutions,\u0120and\u0120(3)\u0120dynamically\u0120adjust\u0120search\u0120complexity.\u0120This\u0120addresses\u0120the\u0120original\u0120algorithm's\u0120difficulty\u0120with\u0120mixed-frequency\u0120patterns\u0120causing\u0120suboptimal\u0120local\u0120convergence.\u010a\u010a2.\u0120Mathematical\u0120specification\u010a\u0120\u0120\u0120Variables:\u0120\u010a\u0120\u0120\u0120-\u0120h(x)\u0120\u00e2\u013f\u00e7\u0128\u00b9\u0120piecewise\u0120constant\u0120function\u0120on\u0120[0,2]\u0120with\u0120N\u0120sample\u0120points\u010a\u0120\u0120\u0120-\u0120dx\u0120=\u01202/N\u010a\u0120\u0120\u0120-\u0120Objective:\u0120minimize\u0120C\u00e2\u0124\u0127\u0120=\u0120(1/dx)\u0120*\u0120\u00e2\u012a\u00a5corr*h*(1-h)\u00e2\u012a\u00a5_\u00e2\u012a\u0140\u010a\u0120\u0120\u0120-\u0120Constraints:\u01200\u00e2\u012b\u00a4h[i]\u00e2\u012b\u00a41,\u0120\u00ce\u00a3h[i]\u0120=\u0120N/2\u010a\u010a\u0120\u0120\u0120We\u0120reformulate\u0120using\u0120spectrum\u0120analysis\u0120to\u0120track:\u010a\u0120\u0120\u0120-\u0120Dominant\u0120frequency\u0120components\u0120responsible\u0120for\u0120overlap\u0120peaks\u010a\u0120\u0120\u0120-\u0120Normalized\u0120amplitude\u0120coefficients\u0120across\u0120N/8\u0120spectral\u0120bands\u010a\u010a\u0120\u0120\u0120Feasibility\u0120constraints\u0120ensure:\u010a\u0120\u0120\u0120-\u0120Integral\u0120conservation\u0120via\u0120projection\u0120(not\u0120clipping)\u010a\u0120\u0120\u0120-\u0120Boundary\u0120conditions\u0120at\u0120resolution\u0120change\u0120points\u010a\u010a3.\u0120Implementation\u0120procedure\u010a\u0120\u0120\u0120def\u0120run(seed=42,budget_s=1300,**kwargs):\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120import\u0120time\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120from\u0120scipy.optimize\u0120import\u0120minimize\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120import\u0120numpy\u0120as\u0120np\u010a\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Function\u0120to\u0120compute\u0120relevant\u0120PSD\u0120and\u0120dominant\u0120frequency\u0120bands\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120def\u0120compute_spectrum(h,\u0120N):\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120corr\u0120=\u0120np.correlate(h,1-h,mode='full')\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120dx\u0120=\u01202.0/N\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120corr_shifted\u0120=\u0120corr\u0120*\u0120dx\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120n_full\u0120=\u01202*N-1\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Compute\u0120frequency\u0120conversion\u0120for\u0120N-point\u0120signal\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120freqs\u0120=\u0120np.linspace(0,\u0120N-1,\u0120n_full)\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Identify\u0120relevant\u0120frequency\u0120bands\u0120(multiples\u0120of\u01200.5)\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120dominance\u0120=\u0120np.log(np.abs(corr_shifted)+1)\u0120\u0120#\u0120Log-sum\u0120for\u0120spectrum\u0120analysis\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120weighted_freqs\u0120=\u0120np.sum(dominance)\u0120/\u0120(n_full)\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Return\u0120top\u01203\u0120frequency\u0120components\u0120with\u0120energy\u0120indices\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120return\u0120weighted_freqs,\u0120np.argsort(-dominance)[::5]\u0120\u0120#\u0120Damped\u0120ranking\u010a\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Global\u0120optimization\u0120stages\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120base_budget\u0120=\u0120budget_s\u0120*\u01200.6\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120sweep_budget\u0120=\u0120budget_s\u0120*\u01200.4\u010a\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Stage\u01201:\u0120initial\u0120setup\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120N0\u0120=\u0120400\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120total_points\u0120=\u0120n_points\u0120=\u01201000\u0120\u0120#\u0120Initial\u0120search\u0120resolution\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120h\u0120=\u0120initial_h_values[:total_points].copy()\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120target_integral\u0120=\u0120total_points\u0120/\u01202\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120h\u0120=\u0120project_feasible(h,\u0120target_integral)\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120best_score\u0120=\u0120compute_c5(h)\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120best_h\u0120=\u0120h.copy()\u010a\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Frequency-discriminated\u0120storage\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120freq_history\u0120=\u0120[]\u0120\u0120#\u0120List\u0120of\u0120(N,\u0120score,\u0120weight)\u0120for\u0120each\u0120resolution\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120freq_weights\u0120=\u0120np.zeros(15)\u0120\u0120#\u0120Tracks\u0120improvement\u0120metrics\u0120across\u0120iterations\u010a\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Stage\u01202:\u0120Progressive\u0120optimization\u0120with\u0120adaptive\u0120refinement\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120for\u0120phase\u0120in\u0120range(3):\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120time_limit\u0120=\u0120(base_budget/(phase+1))\u0120if\u0120phase\u0120else\u0120base_budget\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120n_this\u0120=\u0120total_points\u0120//\u0120(2**(phase))\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120if\u0120n_this\u0120<\u0120400:\u0120n_this\u0120=\u0120400\u010a\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Stage\u01202a:\u0120Frequency-aware\u0120local\u0120tuning\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120keep_local\u0120=\u0120False\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120try:\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120#\u0120Run\u0120core\u0120optimization\u0120with\u0120explicit\u0120frequency\u0120modulation\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120if\u0120time_limit\u0120>\u012060:\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120score_this,\u0120h_this\u0120=\u0120enhanced_cd(h,\u0120n_this,\u0120target_integral,\u0120time_limit\u0120/\u01202)\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120else:\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120score_this\u0120=\u0120compute_c5(h)\u010a\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120\u0120h_this\u0120=\u0120h.copy()\u010a\u010a\u0120\u0120\u01