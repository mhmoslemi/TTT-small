[08:09:24] import numpy as np
[08:09:24] import scipy.optimize as optimize
[08:09:24] import time

[08:09:24] def run(seed=42, budget_s=100, **kwargs):
[08:09:24]     np.random.seed(seed)
[08:09:24]     n_points = len(initial_h_values)
[08:09:24]     target_sum = n_points / 2
[08:09:24]     dx = 2.0 / n_points
[08:09:24]     h = np.array(initial_h_values, dtype=float)
[08:09:24]     
[08:09:24]     def objective(h_vals):
[08:09:24]         corr = np.correlate(h_vals, 1 - h_vals, mode='full')
[08:09:24]         return np.max(corr) * dx
[08:09:24]     
[08:09:24]     def constraint_sum(h_vals):
[08:09:24]         return np.sum(h_vals) - target_sum
[08:09:24]     
[08:09:24]     bounds = [(0.0, 1.0) for _ in range(n_points)]
[08:09:24]     
[08:09:24]     best_h = h.copy()
[08:09:24]     best_c5 = objective(best_h)
[08:09:24]     start_time = time.time()
[08:09:24]     
[08:09:24]     def generate_periodic(period):
[08:09:24]         return np.clip(0.5 + 0.5 * np.sin(2 * np.pi * np.arange(n_points) / period), 0, 1)
[08:09:24]     
[08:09:24]     def generate_binary(freq, duty):
[08:09:24]         return np.clip(np.sin(2 * np.pi * freq * np.arange(n_points)) > 0, 0, 1) * duty
[08:09:24]     
[08:09:24]     def generate_triangular(freq, amp):
[08:09:24]         t = np.linspace(0, 1, n_points)
[08:09:24]         wave = amp * (2 * t - 1) * np.abs(1 - 2 * np.abs(2 * freq * t - 1))
[08:09:24]         return np.clip(wave, 0, 1)
[08:09:24]     
[08:09:24]     def generate_sawtooth(freq, duty):
[08:09:24]         t = np.linspace(0, 1, n_points)
[08:09:24]         wave = 2 * duty * (1 - np.abs(2 * freq * t - 1))
[08:09:24]         return np.clip(wave, 0, 1)
[08:09:24]     
[08:09:24]     guesses = [generate_periodic(p) for p in [3, 4, 5, 6, 7]]
[08:09:24]     guesses += [generate_binary(f, d) for f, d in [(5, 0.3), (6, 0.2), (3, 0.4)]]
[08:09:24]     guesses += [generate_triangular(f, a) for f, a in [(4, 0.6), (3, 0.5)]]
[08:09:24]     guesses += [generate_sawtooth(f, d) for f, d in [(4, 0.25), (5, 0.2)]]
[08:09:24]     guesses.append(np.random.rand(n_points))
[08:09:24]     guesses.append(h)
[08:09:24]     
[08:09:24]     for guess in guesses:
[08:09:24]         res = optimize.minimize(objective, guess, method='SLSQP', bounds=bounds,
[08:09:24]                                constraints=[{'type': 'eq', 'fun': constraint_sum}],
[08:09:24]                                options={'maxiter': 150, 'ftol': 1e-12, 'eps': 1e-10})
[08:09:24]         if res.success and objective(res.x) < best_c5:
