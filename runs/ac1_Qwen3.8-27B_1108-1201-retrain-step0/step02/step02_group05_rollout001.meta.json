ences.append(('smooth', t_perturbed.astype(float)))\n    # Add targeted variation\n    conv = np.convolve(a_base, a_base, mode='full')\n    peak_idx = np.argmax(conv)\n    k = np.arange(n)\n    # These indices contribute most to the peak\n    override = np.exp(-np.sqrt(k*k + (peak_idx - k)**2))\n    override = np.clip(override, 1e-6, None)\n    override = (override + 0.1 * np.random.randn(n)) / sum(override)\n    sequences.append(('bdistinct', override.astype(float)))\n    ```\n\n    - Phase 2: Coordinate optimization using normalized curves\n    ```python\n    best_score = float('inf')\n    best_sequence = None\n    # Assume mother sequence processing already handles any evaluations\n    for name, seq_val in sequences:\n        # Map sequences to their normalized variants\n        seq_norm = (seq_val * 0.05 * (1 + np.random.normal(0, 0.1))) / sum(seq_val)\n        seq_final = np.clip(seq_norm, 0.01, 1000)\n        score = evaluate_sequence(seq_final)\n        if score < best_score:\n            best_score = score\n            best_sequence = seq_final\n        # If initial evaluation found something\n    ```\n\n 4. Search choices and variations:\n    Use a hybrid optimization combining three local search methods:\n\n    s. Filter-based selection:\n    ```python\n    def filter_sequence(data, sigma=1.5):\n        # Standard deviation filter\n        mean_val = np.sum(data)\n        std = np.sqrt(np.sum((np.array(data) - mean_val)**2))\n        # Filter to reduce noise without`too much` destruction\n        data_filtered = []\n        for i in range(n):\n            value = data[i]\n            if std < float(\"inf\"):\n                # For each element, transform by the distance from edges\n                # weighted distance from extremal values\n                tune_factor = 1 - (np.exp(-abs(i/float((n-1)) - 0.5)*sigma)\n                data_filtered.append(max(0.0, min(1000.0, value * tune_factor)))\n        return np.array(data_filtered) / float(n)\n    ```\n\n