e\n    for pos in range(n):\n        # \u521b\u5efa\u4e0d\u5305\u542b\u5f53\u524d\u4f4d\u7f6e\u7684\u526f\u672c\n        copy_seq = sequence.copy()\n        # \u5347\u9ad8\u53c2\u6570\n        copy_seq[pos] += epsilon\n        \n        # \u6b63\u4ea4\u5230\u539f\u59cb\u5e8f\u5217\u7a7a\u95f4\n        normalized_copy = S * copy_seq / np.sum(copy_seq)\n        \n        # \u68c0\u6d4b\u662f\u5426\u6539\u5584\n        new_score = evaluate_sequence(normalized_copy)\n        if new_score < best_score:\n            best_score = new_score\n            best_sequence = normalized_copy.copy()\n    \n    # \u6807\u5fd7\u4f55\u65f6\u9700\u8981\u6700\u7ec8\u8f93\u51fa\n    return best_sequence, best_score\n\ndef fft_convolve(a, b):\n    \"\"\"\u7ebf\u6027\u5377\u79ef\"\"\"\n    n = len(a)\n    m = len(b)\n    if n != m:  # If need uneven array lengths, adjust\n        b = np.pad(b, (0, n - m), 'constant') if m < n else np.pad(b, \nconst(0, m - n), 'constant')\n    fa = np.fft.rfft(a)\n    fb = np.fft.rfft(b)\n    return np.fft.irfft(fa * fb)[:n]\n\ndef extract_critical_points(conv_result):\n    \"\"\"\u63d0\u53d6\u5377\u79ef\u7ed3\u679c\u4e2d\u7684\u5173\u952e\u70b9\"\"\"\n    critical_point = np.argmax(conv_result)\n    return np.linspace(critical_point - 0.5, critical_point + 0.5, 10)\n\ndef fftevolution_acent(sequence, target_conv):\n    \"\"\"FFT-specific\u68af\u5ea6\u4f30\u8ba1\"\"\"\n    n = len(sequence)\n    conv = fft_convolve(sequence, sequence)\n    sig_score = max(conv) / np.sum(conv)**2  # \u7b80\u5316\u5206\u6570\n    \n    updates = np.zeros(n)\n    # \u5bf9\u534a\u5f84\u57280.5\u52301.5\u4e4b\u95f4\u7684\u5173\u952e\u70b9\u8fdb\u884c\u66f4\u65b0\n    for i in range(n):\n        updates[i] = -target_conv[i]\n    \n    return updates\n\ndef initial_geometric_sequence(rng, base_case=1.0, order=3):\n    \"\"\"\u521b\u5efa\u57fa\u7840\u51e0\u4f55\u5e8f\u5217\"\"\"\n    amsr_coins = []\n    for mag in [effect\uff1a\n- **\u6b63\u4ea4\u6027**\uff1a\u9009\u62e9\u5728\u51