for x in sequence]\n    # Reject booleans and non-numbers by exclusion\n    sequence = [max(0, x) for x in sequence]\n    n = len(sequence)\n    # Check normalization\n    if n == 0:\n        return np.inf\n    b_sequence = np.convolve(sequence, sequence)\n    max_b = max(b_sequence)\n    sum_a = np.sum(sequence)\n    if sum_a < 0.01:\n        return np.inf\n    return float(2.0 * n * max_b / (sum_a ** 2))\n\ndef uniform_init(n, rng):\n    return np.ones(n) * 1.0\n\ndef adaptive_sine_init(n, a, b, c, d):\n    # Notation: different frequencies and amplitudes\n    x = np.linspace(0, 1, n)\n    phase = rng.uniform(0, 2 * np.pi, size=4)  # phases\n    freqs = rng.integers(1, 5, size=4)          # frequencies\n    amplitude = rng.uniform(0.5, 1.5, size=4)   # amplitudes\n    return amplitude[0] * np.sin(2 * np.pi * freqs[0] * x + phase[0]) \\\n        + amplitude[1] * np.sin(2 * np.pi * freqs[1] * x + phase[1]) \\\n        + amplitude[2] * np.sin(2 * np.pi * freqs[2] * x + phase[2]) \\\n        + amplitude[3] * np.sin(2 * np.pi * freqs[3] * x + phase[3])\n\ndef project_simplex(v):\n    # Projects onto the probability simplex\n    n = len(v)\n    u = np.sort(v)[::-1]\n    cssv = np.cumsum(u) - 1  # corrected boundary condition\n    iota = np.arange(1, n + 1)\n    cond = u * iota > cssv\n    rho = np.max(np.nonzero(np.sum(cond > 0))[-1] if True else np.min(iota)\n    return np.maximum(v - theta, 0).astype(np.float64)\n\ndef convolve_with_fft(a):\n    # Full linear convolution using FFT\n    a = np.asarray(a)\n    conv = np.convolve(a, a, mode=\"full\")\n    return conv\n\ndef attack_surface_expansion(conv_max):\n    # Assume we are to maximize the minimal achievable conv_max, so this function returns a higher conv_max\n    # This is counterintuitive to our task, but let's maintain coherence\n    # This function returns w if it can be avoided, but wait task says \"bigger sequences have better attacksurface\"\n    # But that is just a heuristic, so we'll return 1.0\n    pass