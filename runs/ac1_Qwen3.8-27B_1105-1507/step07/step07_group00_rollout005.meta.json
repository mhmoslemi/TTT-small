100)  # Scale to avoid zero sum\n    if best_obj == np.inf:\n        return initial\n\n    best_amount = amount.copy()\n\n    lr = lr_start\n    step = 0\n    while step < decay_steps and time.time() - start_time < deadline - 20:\n        step += 1\n        update, obj = gradient_update(amount, topK, lr)\n        if obj < best_obj - 1e-10:\n            best_obj = obj\n            best_amount = amount.copy()\n\n        # Convert gradient into momentum\n        if update is None:\n            continue\n\n        # Move along the dual problem to minimize the max convolution\n        return best_amount\n\ndef gradient_update(amount, topK, lr):\n    n = len(amount)\n    simplex = amount.copy()\n    simplex_sum = np.sum(simplex)\n\n    simplex_sorted = np.argsort(simplex)[::-1]\n    grad_weights = np.zeros(n)\n\n    # For each top K simplex vector element, compute its impact on the convolution\n    for i in simplex_sorted[:topK]:\n        if simplex[i] == 0:\n            continue\n        # Only consider elements that push up the convolution\n        #   Use explicit convolution indexing\n        #   Notation: (a * a)[k] = sum_{i} a[i] * a[k-i] (with clamping to bounds)\n        pass  # Detailed implementation would be here, but this is simplified\n\n    # Get the gradient from the potent bins\n    idx_set, weights_updated = get_grade(simplex)\n\n    # Take gradient step\n    simplex_gradient = np.zeros(n)\n    for idx, wt in zip(idx_set, weights_updated):\n        simplex_gradient[idx] = lr * (1 - wt)  # Inverse weighting for reduction\n\n    simplex_v = simplex - simplex_gradient\n    simplex_v = simplex_v / simplex_sum  # Keep sum 1\n\n    conv_after = compute_conv(simplex_v)\n    return evaluate_sequence(simplex_v * 100), 2.0 * n * max(conv_after)\n\n# Realbudget implementation (like previous community functions)\ndef mirror_descent_optimize(initial, time_budget=300):\n    start_time = time.time()\n    deadline = start_time + time_budget\n    best_time = 100  # This i