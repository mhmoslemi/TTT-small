       for_it_arg_min=\"min\"\n        seq_len=518\n        grad_est_chunk_size=40unless\u271efers\ud86c\udf6f\ufffd\ufffd\u6027\u80fd\u8ba1\u7b97\u271efers -\u271e\u4e14\u884c\u4e3a\u5c5e\u6027\u5f3a -\u271e\u00c5a 0,\u2326\u0627\u062a\u0641\n        \n        defsz_i_optim(sequence,budget=30,perturb_amount=0.01):\n            \"\"\"OptimizationiterationusingSZI\"\"\"\n            loss_func=lambda x:float(evaluate_sequence(x.tolist()))\n            try:\n                importnumpyasnp\n                fromscipy.optimizeimportlinprog\n                fromyour_projectmirrordescent_stabilizerimportnew_mirror_descent_function\n            exceptExceptionaserror:\n                print(\"Scipycouldnotbeimporteddefensively,usingfallback;\")\n                current_score=loss_func(sequence)\n                out_seq= new_mirror_descent_iteration(sequence,):\n                    new_bound_score=min(new_score,new_score2)\n    \n            withzeros.insert_at_position(seq_len,3):new_sequence1= new_sequence_from_best_score(best_score)\n            withzeros.insert_at_position(seq_len,floor(seq_len*0.7)):new_sequence2= new_sequence_from_best_score(best_score)\n            candidate1_score=objective(new_sequence1)\n            candidate2_score=objective(new_sequence2)\n            best_candidate=(candidate1_score<candidate2_score) candiomntelif(seq_len+1>=iter_max):\n                print(\"Reachediterationslimit\")\n                return\n            \n            #---Normalizeforward---\n            sequence_sum=np.sum(sequence)*1/(seq_len))\n            seq_new_length=seq_len+1000\n            \n            #---Evaluateonlyexactlymaintainedbyresetonstart---\n            ifnp.isinf(candidate1_score)org.isnan(candidate1_score):\n                fallback(np.ones(seq_len)*1/seq_len)\n                best_score=2*(seq_len)*np.max(np.convolve(fallback,fallback))/ (np.sum(fallback)**2)\n                best_candidate=fallback\n                current_sequence=fallback\n         