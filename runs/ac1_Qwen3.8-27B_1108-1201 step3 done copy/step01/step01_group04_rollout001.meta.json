  "strategy": "...\n\nSearch space: sequences of length n must be non-negative, with each element between 0 and 1000, and the sum at least 0.01.\nThe objective is: 2*n*max(convolve(a,a))/sum(a)**2\nWe'll use beam search with adaptive diversification, analytical gradient for key steps, and expensive constraint handling by dedicated subprocesses.\n\n```python\nimport numpy as np\nfrom typing import List, Tuple, Dict, Optional, Any\n\ndef evaluate_sequence(seq: List[float]) -> float:\n    \"\"\"Evaluates a sequence of coefficients with defensive checks.\"\"\"\n    if not isinstance(seq, list):\n        return np.inf\n    if not all(isinstance(x, (int, float)) for x in seq):\n        return np.inf\n    if any(isinstance(x, bool) for x in seq):\n        return np.inf\n    if any(not(np.isfinite(x)) or x<0 or x>1000 for x in seq):\n        return np.inf\n    try:\n        n = len(seq)\n        seq_arr = np.array(seq, dtype=np.float64)\n        conv = np.convolve(seq_arr, seq_arr, mode=\"full\")\n        max_conv_val = float(conv.max())\n        total_sum = float(seq_arr.sum())\n        if total_sum < 0.01:\n            return np.inf\n        return float(2.0 * n * max_conv_val / (total_sum**2))\n    except Exception as e:\n        return np.inf\n\ndef _compute_obj(a: np.ndarray) -> float:\n    \"\"\"Compute the optimization objective: normalized score.\"\"\"\n    try:\n        n = len(a)\n        S = np.sqrt(2.0 * n)\n        a_norm = a / a.sum() * S\n        conv = np.convolve(a_norm, a_norm, mode=\"full\")\n        max_conv_val = float(conv.max())\n        return float(2.0 * n * max_conv_val / (a_norm.sum()**2))\n    except Exception as e:\n        return np.inf\n\ndef _normalize(a: np.ndarray, n: int) -> np.ndarray:\n    \"\"\"Normalize to sum sqrt(2n).\"\"\"\n    try:\n        if a.sum() < 1e-12:\n            return np.ones(n)\n        S_target = np.sqrt(2.0 * n)\n        return a * S_target / a.sum()\n    except Exception as e:\n        a[:] = np.ones(n)\n        return a\n\ndef _evaluate_analytic(a: np.ndarray, n: int) -> float:\n    \"\"\"Evaluate the objective using analytical results.\"\"\"\n    try:\n        conv = np.convolve(a, a, mode=\"valid\")\n        # Note: mode=\"valid\" for simplicity, but actual convolution in Fourier domain is used in the objective\n        max_val = float(conv.max())\n        total = float(a.sum())\n        if total < 0.01:\n            return np.inf\n        return float(2.0 * len(a) * max_val / (total**2))\n    except Exception as e:\n        return np.inf\n\ndef _gradient_step(a: np.ndarray, n: int, learning_rate: float) -> np.ndarray:\n    \"\"\"Perform a gradient descent step on normalized sequence.\"\"\"\n    try:\n        # Compute current objective\n        current_obj = _compute_obj(a)\n        \n        # Analytical gradient calculation is expensive, so use finite differences for safety\n        # Calculate gradient at current_obj\n        grad = np.zeros(len(a))\n        for i in range(len(a)):\n            temp = a.copy()\n            a_new = temp[i] + 1e-4  # small perturbation\n            new_conv = np.convolve(a_new, a_new, mode=\"full\")\n            new_obj = float(2.0 * n * new_conv.max() / (np.sum(a_new)**2))\n            grad[i] = -(current_obj - new_obj) / learning_rate\n        # Project gradient for normalization and positivity\n        grad = grad - grad.mean()\n        a = a + learning_rate * grad\n        a[a < 0] = 0\n        return _normalize(a, n)\n    except Exception as e:\n        return a\n\ndef _bound_step(a: np.ndarray, total: float) -> np.ndarray:\n    \"\"\"Adjust sequence to enforce bounds [0, 1000] using FFT.\"\"\"\n    try:\n        # Use numerical differentiation under FFT framework\n        conv = np.convolve(a, a, mode=\"full\")\n        max_val = float(conv.max())\n        if total < 0.01:\n            # Sum insufficient, use fallback normalization\n            total = min(np.sum(x if x > 0 else 0.001 for x in a), 0.01)\n        # Isotropic Laplace distribution component for peak smoothening\n        p = len(a)\n        return (a * (1 - 0.5/total) + (0.5/total) * np.exp(-(np.random.rand(p) - p/2)**2))\n    except Exception as e:\n        # Fallback: simple gradient step\n        n = len(a)\n        try:\n            from scipy.misc import imnoise\n            a = imnoise(\n                _gradient_step(a.copy(), n, 0.1 - total),\n                'gaussian'\n            )\n        except:\n            a = a + p * np.random.rand(n) - p * 0.5\n        a[a < 0] = 0\n        return a\n\ndef propose_candidate(\n    seed_sequence: Optional[np.ndarray] = None,\n    budget_s: float = 1800.0,\n    max_length: int = 1024,\n    **kwargs\n) -> List[float]:\n    \"\"\"\n    Propose candidate sequence minimizing evaluation function.\n    \n    Uses a hierarchical optimization strategy with adaptive diversification.\n    Inner optimizations focus on maintaining [0, 1000] bounds while using FFT-accelerated constraint handling.\n    Main evaluations enforce normalization and actual-bound-checking.\n    Hybrid approach: spectral gradient for low iterations, combinatorial for high iterations.\n    \"\"\"\n    import time\n\n    # Load parent if available\n    if seed_sequence is not None and seed_sequence.size > 0:\n        initial_guess = seed_sequence.astype(np.float64)\n    else:\n        # Initialize from original seed_sequence structure\n        initial_guess = np.ones([256, 2]).flatten()\n\n    if not kwargs:\n        # Get evaluation parameters\n        n_len = kwargs.get('n', 512)\n        alpha = kwargs.get('alpha', 0.9)  # adaptation parameter\n\n     # Main candidate generation loop\n    n_total = 512  # target dimension\n    t0 = time.monotonic()\n    deadline = t0 + budget_s - 20.0\n\n    candidates = []\n    while time.monotonic() < deadline:\n        # Generate candidate variations\n        try:\n            a = np.random.rand(n_len) * 20.0 - 10.0  # raw generation from uniform distribution\n            \n            # Selection-based initialization with global gradient\n            best_val = np.inf\n            \n            if a.sum() < 0.01:\n                # Normalize sum\n                n_factor = 0.01 / a.sum()\n                a = a * n_factor\n                \n                # Reset value index for relevance checking\n                new_candidate = _bound_step(a, 0.01).flatten()\n                candidates.append(new_candidate)\n            else:\n                # Orchestration with adaptive bounds\n                pass\n        except Exception as e:\n            new_candidate = a.copy()\n\n        # Evaluate candidate\n        score = evaluate_sequence(new_candidate)\n        if score < best_val:\n            best_val = score\n        \n        candidates.append(new_candidate)\n    \n    return min(candidates, key=lambda a: evaluate_sequence(a))",
