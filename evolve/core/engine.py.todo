Planned: Algorithm 1.

  per step t:
    tree.recompute()                    # W_m, m_s
    signals.rank(D) ; elo.run_debates(D)
    logits = alpha*R~ + (1-alpha)*E~    # Eq. 3
    actions = dpuct.select(top_n)       # Eq. 4, 5, 6
    prompts = builder.build(d, parent, memory.retrieve(parent, m), instruction)
    rollouts = generator.sample(prompts) # B_t in [n, n*k]
    results  = verifier.evaluate(rollouts)          # r, f
    tree.insert(results) ; memory.update(results)   # 2L lessons
    trainer.step(rollouts, results)                 # Eq. 8-11, LoRA only
  return argmax_{s in D} R(s)
